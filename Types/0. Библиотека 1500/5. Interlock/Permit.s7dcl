{
    S7_BlockNumber := "10502";
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "Permit"
    VAR_OUTPUT
        {
            S7_Access := "ReadOnly := External";
            S7_MLC := "MLC_4Xq";
            S7_Visibility := "Hidden := External"
        }
        First : _.BitDescription;
        {
            S7_Access := "ReadOnly := External";
            S7_MLC := "MLC_4Fg";
            S7_Visibility := "Hidden := External"
        }
        MaskOn : Bool;
    END_VAR
    VAR_IN_OUT
        "Name" : WString;
        Hmi : _.HmiInterlock;
        Conditions : Array[*] of _.BitDescription;
        {
            S7_Access := "ReadOnly := External";
            S7_Visibility := "Hidden := External"
        }
        Stopped : Bool;
    END_VAR
    VAR
        {
            S7_Access := "ReadOnly := External";
            S7_Visibility := "Hidden := External"
        }
        _event : _.PA_Event;
    END_VAR
    VAR_TEMP
        "i" : DInt;
        ActivePermit : DInt;
        _LOWER_BOUND : DInt;
        _UPPER_BOUND : DInt;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        #_LOWER_BOUND := LOWER_BOUND(ARR := #Conditions, DIM := 1);
        #_UPPER_BOUND := UPPER_BOUND(ARR := #Conditions, DIM := 1);
        #ActivePermit := -1;
        
        FOR #i := #_LOWER_BOUND TO #_UPPER_BOUND DO
            // Проверка маски для текущего условия разрешения
            IF #Conditions[#i].Active THEN
                //#Hmi.Input := #Hmi.Input OR DINT_TO_WORD(2 ** #i);
                #Hmi.Input := #Hmi.Input OR SHL(IN := WORD#1, N := #i);
            ELSE
                //#Hmi.Input := #Hmi.Input AND NOT DINT_TO_WORD(2 ** #i);
                #Hmi.Input := #Hmi.Input AND (NOT SHL(IN := WORD#1, N := #i));
                
                //IF ((#Hmi.Mask AND DINT_TO_WORD(2 ** #i)) = 16#0) THEN
                IF ((SHR(IN:=#Hmi.Mask, N:=#i) AND WORD#1) = 16#0) THEN
                    #ActivePermit := #i;
                END_IF;
            END_IF;
        END_FOR;
        
        IF #ActivePermit >= 0 THEN
            #First := #Conditions[#ActivePermit];
        ELSE
            IF NOT #First.Active THEN
                #First.Reason := WSTRING#'';
            END_IF;
            #First.Active := TRUE;
        END_IF;
        
        // Если условия запуска не выполняются, то покажем сообщение
        IF NOT #Stopped THEN
            IF NOT #First.Active THEN
                #_event(Name := #Name,
                        Text := #First.Reason);
            END_IF;
        END_IF;
        
        #MaskOn := #Hmi.Mask <> 16#0; // маскировка включена
    END_NETWORK
END_FUNCTION_BLOCK
